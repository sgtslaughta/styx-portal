{
  "id": "jellyfin",
  "name": "Jellyfin",
  "icon": "🎬",
  "default_port": 8096,
  "mount_mode": "path",
  "auth_mode": "sso",
  "bypass_rules": [
    {
      "path_prefix": "/jellyfin/",
      "required_header": "Authorization",
      "header_prefix": "MediaBrowser"
    },
    {
      "path_prefix": "/jellyfin/",
      "required_header": "X-Emby-Authorization",
      "header_prefix": "MediaBrowser"
    },
    {
      "path_prefix": "/jellyfin/",
      "required_header": "X-Emby-Token"
    },
    {
      "path_prefix": "/jellyfin/",
      "required_header": "X-MediaBrowser-Token"
    },
    {
      "path_prefix": "/jellyfin/",
      "required_query": "api_key"
    }
  ],
  "health_path": "/jellyfin/health",
  "verify_tls": true,
  "base_url_hint": "Dashboard → Networking → Base URL = /jellyfin, then restart Jellyfin.",
  "warnings": [
    "Allow native apps lets Jellyfin apps sign in with Jellyfin's own login, so that login is reachable from the internet."
  ],
  "subpath": {
    "methods": [
      {
        "type": "config_file",
        "paths": [
          "/config/config/network.xml",
          "/config/network.xml"
        ],
        "format": "xml",
        "key": "/NetworkConfiguration/BaseUrl"
      }
    ],
    "restart": true,
    "verify_path": "/{slug}/health",
    "missing_hint": "Open Jellyfin, go to Dashboard \u203a Networking and click Save once so it writes its network settings, then try again."
  }
}
